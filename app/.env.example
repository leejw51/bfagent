# Copy to .env and fill in your values. .env is git-ignored.
#
# Hugging Face access token — used by huggingface_hub for model downloads.
# Get one at https://huggingface.co/settings/tokens (a read-only token is enough).
#
# Why set this:
#   - Authenticated downloads use parallel HTTPS connections via hf_transfer
#     and are dramatically faster than anonymous downloads.
#   - Required for any gated/private repos.
export HF_TOKEN=

# Optional: enable the high-throughput Rust downloader. Requires `pip install
# hf_transfer` (or `huggingface_hub[hf_transfer]`). Big speedup on fast links.
export HF_HUB_ENABLE_HF_TRANSFER=1

# Optional: pin a different model repo. Honored by the backend, frontend, CLI,
# and every helper script (download.py, info.py, hello.py, detect.py, visual.py,
# functioncall.py, stream.py). If unset, defaults to the value below.
export BFAGENT_MODEL=mlx-community/gemma-4-e2b-it-4bit
